{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-native": ["./node_modules/react-native/types_generated/index.d.ts"],
      "@react-native-async-storage/async-storage": ["./node_modules/@react-native-async-storage/async-storage"],
      "@react-native-picker/picker": ["./node_modules/@react-native-picker/picker"],
      "expo-status-bar": ["./node_modules/expo-status-bar"]
    }
  },
  "include": ["*.ts", "*.tsx", "../../../shared/*.ts", "../../../shared/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
