  "license": "MIT",
  "bin": {
    "sheet-relay": "bin/sheet-relay.mjs"
  },
  "files": [
    "server.js",
    "static.js",
    "headless.mjs",
    "bin",
    "apps",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GabrielDiasMoraes/sheet-relay.git"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "foundry-vtt",
    "foundryvtt",
    "character-sheet",
    "rpg"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
