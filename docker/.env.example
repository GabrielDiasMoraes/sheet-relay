# Which Foundry system your world uses (also the plugin that gets loaded): dnd5e | fallout | legends
SYSTEM=dnd5e
# Shared secret between the relay and the Foundry module (module setting "Relay secret"). Use a long random value.
RELAY_SECRET=change-me-to-a-long-random-string
# Foundry user the headless browser logs in as (create it in your world; role Assistant GM) and its password
RELAY_USER=Relay
RELAY_PASSWORD=change-me
# Host name of your Foundry server as seen from the containers ("foundry" = the foundry profile of this compose file)
FOUNDRY_HOST=foundry
# Only for the caddy profile
DOMAIN=sheets.example.org
